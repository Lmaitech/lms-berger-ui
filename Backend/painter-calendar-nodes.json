{
  "name": "LMS - Painter Visits Endpoint",
  "nodes": [
    {
      "parameters": {
        "content": "### Painter Consultation Calendar API\n\n**Functions & Features:**\n- **GET /painter-visits**: Serves scheduled and completed visit timelines.\n- **Count Check**: Determines completion stats based on geolocated visits.",
        "height": 220,
        "width": 340
      },
      "name": "Sticky Note - Painter Consultation Calendar API",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -100,
        100
      ]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "painter-visits",
        "responseMode": "responseNode",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              },
              {
                "name": "Access-Control-Allow-Headers",
                "value": "Content-Type"
              },
              {
                "name": "Access-Control-Allow-Methods",
                "value": "GET, OPTIONS"
              }
            ]
          }
        }
      },
      "name": "Webhook - GET /painter-visits",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT l.lead_id, l.site_owner_name, l.site_owner_mobile, l.address_line1, l.town, TO_CHAR(l.visit_date, 'YYYY-MM-DD') as visit_date, TO_CHAR(l.visit_time, 'HH12:MI AM') as formatted_visit_time, l.current_status, (SELECT COUNT(*) FROM site_visits sv WHERE sv.lead_id = l.lead_id) as visit_count FROM leads l WHERE l.current_painter_id = '{{$node[\"Webhook - GET /painter-visits\"].json[\"query\"][\"painter_id\"]}}' ORDER BY l.visit_date DESC, l.visit_time ASC;"
      },
      "name": "Postgres - Query Painter Visits",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        320,
        300
      ],
      "credentials": {
        "postgresDb": {
          "id": "postgres-cred-id",
          "name": "Supabase Postgres Connection"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{JSON.stringify($json)}}",
        "options": {}
      },
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        540,
        300
      ]
    }
  ],
  "connections": {
    "Webhook - GET /painter-visits": {
      "main": [
