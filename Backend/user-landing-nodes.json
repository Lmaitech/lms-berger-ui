        "query": "=INSERT INTO estimates (estimate_id, lead_id, painter_id, estimate_version, estimate_json, estimate_mode, estimate_type, material_total, labour_cost, discount, grand_total, submitted_at)\nVALUES (gen_random_uuid(), '{{$node[\"Webhook - POST Submit Estimate\"].json[\"body\"][\"lead_id\"]}}', '{{$node[\"Webhook - POST Submit Estimate\"].json[\"body\"][\"painter_id\"]}}', {{$node[\"Postgres - Calculate New Version\"].json[\"new_version\"]}}, '{{JSON.stringify($node[\"Webhook - POST Submit Estimate\"].json[\"body\"][\"estimate_items\"])}}'::jsonb, '{{$node[\"Webhook - POST Submit Estimate\"].json[\"body\"][\"mode\"]}}', '{{$node[\"Webhook - POST Submit Estimate\"].json[\"body\"][\"estimate_type\"]}}', {{$node[\"Webhook - POST Submit Estimate\"].json[\"body\"][\"material_total\"]}}, {{$node[\"Webhook - POST Submit Estimate\"].json[\"body\"][\"labour_cost\"]}}, {{$node[\"Webhook - POST Submit Estimate\"].json[\"body\"][\"discount\"] || 0}}, {{$node[\"Webhook - POST Submit Estimate\"].json[\"body\"][\"grand_total\"]}}, NOW())\nRETURNING estimate_id;"
