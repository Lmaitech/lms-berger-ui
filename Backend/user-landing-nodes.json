    {
      "parameters": {
        "jsCode": "const items = $node[\"Webhook - POST Submit Estimate\"].json[\"body\"][\"estimate_items\"] || [];\nconst estimateId = $node[\"Postgres - Insert Estimate\"].json[\"estimate_id\"];\n\nif (items.length === 0) {\n  return { query: \"SELECT 1;\" };\n}\n\nlet query = \"INSERT INTO estimate_items (estimate_item_id, estimate_id, product_id, quantity, rate, line_total) VALUES \";\nconst values = items.map(item => {\n  const qty = parseFloat(item.quantity) || 0;\n  const rate = parseFloat(item.rate) || 0;\n  const total = qty * rate;\n  return `(gen_random_uuid(), '${estimateId}', '${item.product_id}', ${qty}, ${rate}, ${total})`;\n});\nquery += values.join(\", \") + \" RETURNING estimate_item_id;\";\n\nreturn { query: query };"
