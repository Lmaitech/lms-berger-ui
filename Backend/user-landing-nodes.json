        "query": "=SELECT \n  (\n    SELECT COALESCE(json_agg(status_row), '[]'::json)\n    FROM (\n      SELECT status_history_id, old_status, new_status, remarks, changed_at\n      FROM lead_status_history\n      WHERE lead_id = '{{$node[\"Webhook - GET History\"].json[\"query\"][\"lead_id\"]}}'\n      ORDER BY changed_at ASC\n    ) status_row\n  ) AS status_history,\n  (\n    SELECT COALESCE(json_agg(assign_row), '[]'::json)\n    FROM (\n      SELECT *\n      FROM lead_assignment_history_view\n      WHERE lead_id = '{{$node[\"Webhook - GET History\"].json[\"query\"][\"lead_id\"]}}'\n      ORDER BY assigned_at ASC\n    ) assign_row\n  ) AS assignment_history;"
