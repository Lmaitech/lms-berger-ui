{
  "name": "LMS - Painter Assignment Timeout Checker",
  "nodes": [
    {
      "parameters": {
        "content": "### Painter Assignment Timeout Checker\n\n**Functions & Features:**\n- **Schedule Trigger**: Cron job running automatically every 2 hours.\n- **Timeout Detection**: Selects active assignments older than 6 hours.\n- **Status Update**: Modifies records to 'EXPIRED' status.\n- **Re-assignment webhook**: Triggers painter selection webhook.",
        "height": 220,
        "width": 340
      },
      "name": "Sticky Note - Painter Assignment Timeout Checker",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -100,
        100
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 2
            }
          ]
        }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT lah.lead_id, l.retailer_id, lah.assignment_id, lah.painter_id FROM lead_assignment_history lah JOIN leads l ON lah.lead_id = l.lead_id WHERE lah.response_status = 'PENDING' AND l.current_status = 'ASSIGNED' AND lah.assigned_at < NOW() - INTERVAL '6 hours';"
      },
      "name": "Postgres - Query Expired Assignments",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        320,
        300
      ],
      "credentials": {
        "postgresDb": {
          "id": "postgres-cred-id",
          "name": "Supabase Postgres Connection"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE lead_assignment_history SET response_status = 'EXPIRED', response_at = NOW() WHERE assignment_id = '{{$json.assignment_id}}' RETURNING assignment_id;"
      },
      "name": "Postgres - Mark Assignment Expired",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        540,
        300
      ],
      "credentials": {
        "postgresDb": {
          "id": "postgres-cred-id",
          "name": "Supabase Postgres Connection"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://n8n.srv1348908.hstgr.cloud/webhook/assign-painter",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"lead_id\": \"{{$node[\"Postgres - Query Expired Assignments\"].json[\"lead_id\"]}}\",\n  \"retailer_id\": \"{{$node[\"Postgres - Query Expired Assignments\"].json[\"retailer_id\"]}}\"\n}",
        "options": {}
      },
      "name": "HTTP Request - Trigger Reassignment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        760,
        300
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Postgres - Query Expired Assignments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres - Query Expired Assignments": {
      "main": [
        [
          {
            "node": "Postgres - Mark Assignment Expired",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres - Mark Assignment Expired": {
      "main": [
        [
          {
            "node": "HTTP Request - Trigger Reassignment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}